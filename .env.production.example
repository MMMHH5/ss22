# Production environment — copy this file to `.env.production` and fill in real
# values. `.env.production` holds secrets and is gitignored — NEVER commit it.
#
# Used by `docker-compose.prod.yml` (self-hosted target). Railway is the primary
# managed target (see DEPLOYMENT.md) and reads these same variables from its
# service dashboards instead of an env file.

# ----- Core -----
NODE_ENV=production
PORT=3000

# ----- Database (Compose creates the DB from these; backend builds DATABASE_URL) -----
DB_USER=laxalab_admin
DB_PASS=change_me_strong_password
DB_NAME=laxalab_db

# ----- Auth / JWT -----
JWT_SECRET=change_me_long_random_string

# ----- Frontend URL (public) + API URL (baked into the frontend bundle) -----
FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_CURRENCY=SAR

# ----- Shared uploads (required by the Render Blueprint) -----
# Cloudflare R2 S3 API endpoint, bucket name, and an API token with object
# read/write access. Keep the token secret; never commit populated values.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ----- Google OAuth -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback

# ----- SMTP (email) -----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ----- Stripe (leave empty to use manual payment only) -----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ----- Admin bootstrap -----
ADMIN_EMAIL=admin@yourdomain.com

# ----- Operations center (/operations) -----
# Second password required on top of the admin JWT. If this is unset the page
# fails closed: unlock always returns 401 and no data is served. Generate one
# with `openssl rand -base64 24`.
#
# BOOTSTRAP ONLY. This variable is the fallback used until an admin sets a
# password from /operations → Settings. Once that password exists, this variable
# is ignored entirely -- which is deliberate, so that rotating the password in the
# UI cannot be silently defeated by an old value still sitting in Railway.
# After setting the password there, DELETE this variable from the service: keeping
# it leaves a plaintext copy of a credential in the dashboard, and it is exactly
# the kind of backup you do not want for the key to your own audit log.
OPERATIONS_KEY=

# ----- TLS / Nginx (self-hosted Compose target only) -----
DOMAIN=yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com

# ----- Optional frontend analytics -----
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=